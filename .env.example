GEMINI_API_KEY=prompt
NODE_ENV=development
PORT=3000
JWT_SECRET=replace_with_a_long_random_secret
DATABASE_URL=
# Leave blank for direct connections. Set only when the deployment is behind a trusted proxy.
TRUST_PROXY=
# Optional single-process login limiter settings. IP, ID, and combination buckets are independent.
LOGIN_RATE_LIMIT_IP_WINDOW_MS=900000
LOGIN_RATE_LIMIT_IP_MAX=200
LOGIN_RATE_LIMIT_ID_WINDOW_MS=900000
LOGIN_RATE_LIMIT_ID_MAX=20
LOGIN_RATE_LIMIT_COMBINATION_WINDOW_MS=900000
LOGIN_RATE_LIMIT_COMBINATION_MAX=20
LOGIN_RATE_LIMIT_MAX_ENTRIES=10000
# Never enable this in production. Error names only; messages/stacks remain suppressed.
AUTH_DEBUG_ERRORS=false
